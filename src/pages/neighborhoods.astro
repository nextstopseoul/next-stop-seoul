---
import Base from '../layouts/Base.astro';
import { AREAS } from '../site.config.mjs';
import { getPosts, areaUrl, LINE_COLORS, allAreas } from '../lib/utils';
const posts = await getPosts();
const areas = allAreas(AREAS, posts);
const lines = ['1', '2', '3', '4', '5', '6', '7', '8', '9'];
---
<Base title="Seoul neighborhoods" description="Find things to do in Seoul by neighborhood.">
  <section class="band">
    <div class="wrap">
      <h1>Seoul, neighborhood by neighborhood</h1>
      <p class="muted lead">Each stop on this line is a part of the city with its own personality.</p>
      <ol class="stops">
        {areas.map((a, i) => {
          const n = posts.filter((p) => p.data.area === a).length;
          return (
            <li style={`--c:${LINE_COLORS[lines[i % 9]]}`}>
              <a href={areaUrl(a)}><span class="stop" aria-hidden="true"></span><strong>{a}</strong><span class="muted">{n} {n === 1 ? 'guide' : 'guides'}</span></a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>
</Base>
<style>
  .lead { font-size: 18px; margin-bottom: 32px; }
  .stops { list-style: none; padding: 0; margin: 0; max-width: 560px; }
  .stops li { position: relative; padding-left: 44px; }
  .stops li::before { content: ''; position: absolute; left: 14px; top: 0; bottom: 0; width: 8px; background: var(--c); }
  .stops li:first-child::before { top: 24px; }
  .stops li:last-child::before { bottom: calc(100% - 24px); }
  .stops a { display: flex; gap: 12px; align-items: baseline; padding: 12px 0; color: var(--ink); text-decoration: none; font-size: 19px; }
  .stops a:hover strong { color: var(--blue); }
  .stop { position: absolute; left: 6px; top: 13px; width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 5px solid var(--c); }
  .stops .muted { font-size: 14px; }
</style>
