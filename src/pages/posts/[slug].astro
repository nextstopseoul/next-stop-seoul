---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SITE } from '../../site.config.mjs';
import { getPosts, fmtDate, readingTime, eventStatus, stationHtml, categoryUrl, areaUrl, type Post } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const d = post.data;
const { Content } = await render(post);
const mins = readingTime(post.body);
const ended = eventStatus(d.event) === 'ended';
const qf = d.quickFacts;
const related = posts
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: (p.data.area === d.area ? 2 : 0) + (p.data.category === d.category ? 1 : 0) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((x) => x.p);

const url = new URL(`/posts/${post.id}/`, SITE.url).href;
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
    image: [new URL(d.hero.src, SITE.url).href], datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(), mainEntityOfPage: url,
    author: { '@type': 'Organization', name: SITE.author }, publisher: { '@type': 'Organization', name: SITE.name },
  },
];
if (d.event && qf) jsonLd.push({
  '@context': 'https://schema.org', '@type': 'Event', name: qf.name, startDate: d.event.start.toISOString().slice(0, 10),
  endDate: d.event.end.toISOString().slice(0, 10), eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: qf.name, address: { '@type': 'PostalAddress', addressLocality: 'Seoul', addressCountry: 'KR' } },
  image: [new URL(d.hero.src, SITE.url).href], description: d.description,
});
if (d.faq.length) jsonLd.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const english = qf?.englishLevel ?? 0;
---
<Base title={d.title} description={d.description} image={d.hero.src} type="article" jsonLd={jsonLd}>
  <article>
    <header class="wrap post-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>›</span><a href={categoryUrl(d.category)}>{d.category}</a>
        {d.area && <><span>›</span><a href={areaUrl(d.area)}>{d.area}</a></>}
      </nav>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <div class="post-meta">
        <StatusBadge event={d.event} />
        <span>Updated {fmtDate(d.updatedDate ?? d.pubDate)}</span>
        <span>· {mins} min read</span>
      </div>
    </header>

    <div id="ended-banner" class="wrap ended" hidden={!ended}>
      <strong>This event has ended.</strong> Details below are kept for reference — see
      <a href={categoryUrl('Weekly Guide')}>what's on in Seoul this week</a> instead.
    </div>

    <figure class="wrap hero">
      <img src={d.hero.src} alt={d.hero.alt} width="1600" height="1000" fetchpriority="high" />
      {d.hero.credit && <figcaption>Photo: {d.hero.credit}</figcaption>}
    </figure>

    <div class="wrap post-body">
      {qf && (
        <aside class="facts" aria-label="Quick facts">
          <h2>Quick facts</h2>
          <dl>
            <div><dt>Name</dt><dd>{qf.name}{qf.korean && <span class="ko" lang="ko"> · {qf.korean}</span>}</dd></div>
            {qf.dates && <div><dt>Dates</dt><dd>{qf.dates}</dd></div>}
            {qf.hours && <div><dt>Hours</dt><dd>{qf.hours}</dd></div>}
            {qf.price && <div><dt>Price</dt><dd>{qf.price}</dd></div>}
            {qf.station && <div><dt>Subway</dt><dd set:html={stationHtml(qf.station)} /></div>}
            {qf.reservation && <div><dt>Booking</dt><dd>{qf.reservation}</dd></div>}
            {qf.payment && <div><dt>Payment</dt><dd>{qf.payment}</dd></div>}
            {english > 0 && (
              <div><dt>English</dt><dd><span class="meter" aria-label={`${english} out of 5`}>{[1, 2, 3, 4, 5].map((i) => <i class={i <= english ? 'on' : ''} />)}</span></dd></div>
            )}
          </dl>
          {qf.mapQuery && (
            <a class="btn" href={`https://map.naver.com/p/search/${encodeURIComponent(qf.mapQuery)}`} rel="noopener">Open in Naver Map</a>
          )}
          <p class="note">Google Maps shows transit routes in Korea but no turn-by-turn walking directions — Naver Map or KakaoMap work best.</p>
        </aside>
      )}
      <div class="prose">
        <Content />
        <AdSlot />
        {d.faq.length > 0 && (
          <section class="faq">
            <h2>FAQ</h2>
            {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </section>
        )}
        {d.koreanUrl && <p class="korean">Read this guide in Korean: <a href={d.koreanUrl}>한국어로 보기</a></p>}
        {d.credits.length > 0 && (
          <section class="credits">
            <h3>Photo credits</h3>
            <ul>{d.credits.map((c) => <li>{c}</li>)}</ul>
          </section>
        )}
        {d.tags.length > 0 && <div class="chips tags">{d.tags.map((t) => <span class="chip">#{t}</span>)}</div>}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="band soft">
      <div class="wrap">
        <div class="section-head"><h2>You might also like</h2></div>
        <div class="grid">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .post-head { padding-top: 36px; max-width: 860px; margin-inline: auto; width: min(860px, 100% - 2 * max(4vw, 16px)); }
  .crumbs { display: flex; gap: 8px; flex-wrap: wrap; font-size: 14px; color: var(--muted); margin-bottom: 18px; }
  .crumbs a { color: var(--muted); text-decoration: none; font-weight: 600; }
  .crumbs a:hover { color: var(--blue); }
  .lead { font-size: 19px; color: var(--muted); margin: 0 0 18px; max-width: 64ch; }
  .post-meta { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; font-size: 14px; color: var(--muted); }
  .ended { margin-top: 20px; padding: 14px 18px; border-radius: 12px; background: #fff4cc; color: #5c4300; }
  .ended[hidden] { display: none; }
  .hero { margin-top: 28px; margin-bottom: 0; }
  .hero img { width: 100%; aspect-ratio: 16 / 8; object-fit: cover; border-radius: 24px; }
  .hero figcaption { font-size: 13px; color: var(--muted); margin-top: 8px; text-align: right; }
  .post-body { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 56px; align-items: start; padding-block: 40px 24px; }
  .facts { order: 2; position: sticky; top: 92px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); }
  .facts h2 { font-size: 20px; margin-bottom: 14px; }
  .facts dl { margin: 0 0 18px; display: grid; gap: 0; }
  .facts dl > div { display: grid; grid-template-columns: 84px 1fr; gap: 12px; padding: 11px 0; border-top: 1px dashed var(--line); font-size: 15px; line-height: 1.5; }
  .facts dt { color: var(--muted); font-weight: 600; font-size: 14px; }
  .facts dd { margin: 0; font-weight: 600; }
  .facts .ko { color: var(--muted); font-weight: 500; word-break: keep-all; }
  .facts .btn { width: 100%; justify-content: center; background: #03c75a; }
  .facts .btn:hover { background: #02a84c; }
  .facts .note { font-size: 13px; color: var(--muted); margin: 12px 0 0; line-height: 1.5; }
  .meter { display: inline-flex; gap: 4px; vertical-align: -1px; }
  .meter i { width: 18px; height: 8px; border-radius: 4px; background: var(--line); }
  .meter i.on { background: var(--mint); }
  .prose { max-width: 70ch; }
  .prose :global(h2) { margin-top: 1.8em; }
  .prose :global(h3) { margin-top: 1.4em; }
  .prose :global(p), .prose :global(li) { font-size: 17px; }
  .prose :global(figure) { margin: 28px 0; }
  .prose :global(figure img) { border-radius: 16px; width: 100%; max-height: 620px; object-fit: cover; }
  .prose :global(figcaption) { font-size: 14px; color: var(--muted); margin-top: 8px; }
  .prose :global(blockquote) { margin: 24px 0; padding: 16px 20px; border-radius: 14px; background: var(--soft); border-left: 4px solid var(--blue); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 15px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px; border-bottom: 1px solid var(--line); }
  .faq details { border: 1px solid var(--line); border-radius: 14px; padding: 0 18px; margin-bottom: 10px; }
  .faq summary { cursor: pointer; font-weight: 700; padding: 16px 0; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  .faq summary::after { content: '+'; font: 700 22px/1 var(--head); color: var(--blue); }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { margin: 0 0 16px; color: var(--muted); }
  .korean { padding: 14px 18px; border-radius: 12px; background: var(--soft); }
  .credits { margin-top: 32px; font-size: 13px; color: var(--muted); }
  .credits h3 { font-size: 15px; }
  .credits ul { padding-left: 18px; margin: 0; }
  .tags { margin-top: 24px; }
  @media (max-width: 980px) {
    .post-body { grid-template-columns: 1fr; gap: 32px; }
    .facts { order: 0; position: static; }
    .hero img { aspect-ratio: 4 / 3; border-radius: 18px; }
  }
</style>
