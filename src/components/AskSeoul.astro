---
// Floating "Ask about Seoul" assistant. Posts to /api/ask (Gemini, server-side).
---
<div class="ask" data-ask>
  <button class="ask-toggle" type="button" aria-expanded="false" aria-controls="ask-panel">
    <span class="ask-dot" aria-hidden="true"></span>Ask about Seoul
  </button>
  <section class="ask-panel" id="ask-panel" hidden aria-label="Ask about Seoul">
    <header>
      <strong>Ask about Seoul</strong>
      <button class="ask-close" type="button" aria-label="Close">×</button>
    </header>
    <div class="ask-log" aria-live="polite">
      <p class="ask-msg bot">Hi! Ask me anything about visiting Seoul — what's on, where to eat, how to get there.</p>
    </div>
    <form class="ask-form">
      <label class="sr" for="ask-input">Your question</label>
      <input id="ask-input" name="q" maxlength="500" autocomplete="off" placeholder="e.g. Rainy day ideas in Hongdae?" required />
      <button class="btn" type="submit">Ask</button>
    </form>
    <p class="ask-note">AI answers can be wrong — check official sites before you go.</p>
  </section>
</div>

<style>
  .ask { position: fixed; right: 16px; bottom: 16px; z-index: 30; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .ask-toggle { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 20px; border: 0; border-radius: 999px; background: var(--blue); color: #fff; font: 700 15px var(--body); box-shadow: var(--shadow); cursor: pointer; }
  .ask-toggle[hidden] { display: none; }
  .ask-toggle:hover { background: var(--blue-deep); }
  .ask-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--sun); box-shadow: 0 0 0 3px rgb(255 255 255 / 35%); }
  .ask-panel { width: min(380px, calc(100vw - 32px)); max-height: min(560px, calc(100dvh - 100px)); display: flex; flex-direction: column; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
  .ask-panel[hidden] { display: none; }
  .ask-panel header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--soft); font-family: var(--head); }
  .ask-close { border: 0; background: none; font-size: 24px; line-height: 1; color: var(--muted); cursor: pointer; padding: 4px 8px; }
  .ask-log { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; }
  .ask-log :global(.ask-msg) { margin: 0; padding: 10px 14px; border-radius: 14px; font-size: 15px; line-height: 1.5; white-space: pre-wrap; max-width: 90%; }
  .ask-log :global(.ask-msg.bot) { background: var(--soft); align-self: flex-start; }
  .ask-log :global(.ask-msg.me) { background: var(--blue); color: #fff; align-self: flex-end; }
  .ask-log :global(.ask-msg.err) { background: #fff1ee; color: #b3321b; align-self: flex-start; }
  .ask-form { display: flex; gap: 8px; padding: 12px 16px 4px; border-top: 1px solid var(--line); }
  .ask-form input { flex: 1; min-height: 46px; padding: 0 14px; border: 1.5px solid var(--line); border-radius: 999px; font: 15px var(--body); }
  .ask-form input:focus { outline: none; border-color: var(--blue); }
  .ask-form .btn { cursor: pointer; }
  .ask-form .btn:disabled { opacity: .6; cursor: wait; }
  .ask-note { margin: 0; padding: 4px 16px 12px; font-size: 12px; color: var(--muted); }
  @media print { .ask { display: none; } }
</style>

<script>
  const root = document.querySelector('[data-ask]') as HTMLElement;
  const toggle = root.querySelector('.ask-toggle') as HTMLButtonElement;
  const panel = root.querySelector('.ask-panel') as HTMLElement;
  const log = root.querySelector('.ask-log') as HTMLElement;
  const form = root.querySelector('.ask-form') as HTMLFormElement;
  const input = form.querySelector('input') as HTMLInputElement;
  const submit = form.querySelector('button') as HTMLButtonElement;

  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    toggle.hidden = open;
    toggle.setAttribute('aria-expanded', String(open));
    if (open) input.focus(); else toggle.focus();
  };
  toggle.addEventListener('click', () => setOpen(true));
  root.querySelector('.ask-close')!.addEventListener('click', () => setOpen(false));
  panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  const add = (text: string, cls: string) => {
    const p = document.createElement('p');
    p.className = `ask-msg ${cls}`;
    p.textContent = text;
    log.append(p);
    log.scrollTop = log.scrollHeight;
    return p;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = input.value.trim();
    if (!question) return;
    add(question, 'me');
    input.value = '';
    submit.disabled = true;
    const pending = add('Thinking…', 'bot');
    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ question }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.answer) throw new Error(data.error || 'Something went wrong. Please try again.');
      pending.textContent = data.answer;
    } catch (err) {
      pending.className = 'ask-msg err';
      pending.textContent = err instanceof Error ? err.message : 'Something went wrong.';
    } finally {
      submit.disabled = false;
      input.focus();
    }
  });
</script>
